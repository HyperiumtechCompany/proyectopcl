APP_NAME=PCL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# A dónde llegan las notificaciones de nuevas solicitudes de plan (ver
# PlanRequestController). Si no se define, cae en el correo del admin
# principal.
ADMIN_NOTIFICATION_EMAIL=programdesing.rizabalasociados@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=false
# REVERB_SCALING_CHANNEL=reverb

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------------------------------------------------------------------------
# Producción (VPS Ubuntu 24.04 LTS) — colaboración en tiempo real con Redis
# ---------------------------------------------------------------------------
# En local (Windows) el broadcasting de Reverb funciona standalone y colas/
# cache usan la BD, sin dependencias extra. En producción, con varios workers
# de PHP-FPM/queue, Reverb necesita Redis como bus de escalado para que los
# eventos lleguen a todos los procesos. Instalar en el VPS:
#   sudo apt install redis-server php8.3-redis
#   sudo systemctl enable --now redis-server
# Configurar redis-server para escuchar solo en 127.0.0.1 y con `requirepass`
# (no exponerlo a internet). Luego sobrescribir en el .env de producción:
#
# REVERB_SCALING_ENABLED=true
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# REDIS_CLIENT=phpredis
# REDIS_PASSWORD=<password fuerte, no "null">
#
# No requiere cambios de código: config/queue.php, config/cache.php y
# config/reverb.php ya leen estas variables (bloque 'redis' / 'scaling').

# ---------------------------------------------------------------------------
# Producción — correo real (solicitudes de plan + credenciales de cuenta)
# ---------------------------------------------------------------------------
# Con MAIL_MAILER=log (el default local) los correos solo se escriben en
# storage/logs/laravel.log, nunca llegan a una bandeja real. Para que
# PlanRequestReceived/AccountCredentialsMail se entreguen de verdad, usar SMTP
# real en producción. Con una cuenta de Gmail (la misma de
# ADMIN_NOTIFICATION_EMAIL funciona bien como remitente):
#   1. Activar verificación en 2 pasos en la cuenta de Gmail.
#   2. Generar una "contraseña de aplicación" en
#      https://myaccount.google.com/apppasswords (NO uses la contraseña normal
#      de la cuenta, Gmail la rechaza para SMTP de apps).
#   3. Sobrescribir en el .env de producción:
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=tu-correo@gmail.com
# MAIL_PASSWORD="contraseña de aplicación de 16 caracteres"
# MAIL_FROM_ADDRESS="tu-correo@gmail.com"
# MAIL_FROM_NAME="PCL"
#
# Alternativa sin depender de una cuenta personal de Gmail: un proveedor
# transaccional (Mailgun, Brevo, SES) — mismas variables MAIL_*, solo cambia
# el host/puerto según el proveedor.
